# =====================================================================
# CyberShield Community — environment template (PLACEHOLDERS ONLY)
# Copy to `.env` (git-ignored — NEVER commit real values) and fill in.
# Sections: (A) shared, (B) development, (C) testing, (D) production.
# =====================================================================

# ---------------------------------------------------------------- (A) shared
# APP_ENV is read by Docker Compose; the backend itself reads ENV.
# Allowed: development | testing | production
APP_ENV="development"
ENV="development"

# Backend listen address/port (compose maps the port; keep 8001).
BACKEND_HOST="0.0.0.0"
BACKEND_PORT="8001"

# Public base URL of the backend (used by the frontend nginx proxy and
# external clients). Local default points at the compose backend service.
PUBLIC_BACKEND_URL="http://localhost:8001"

# ---------------------------------------------------------------- (B) development
# Frontend dev server calls /api via the Vite proxy; VITE_BACKEND_URL is
# only needed for direct backend calls. NOTE: VITE_* values are embedded
# in the browser bundle — public configuration ONLY, never secrets.
VITE_BACKEND_URL="http://localhost:8001"

# CORS (comma-separated). Unset = localhost dev origins only.
ALLOWED_ORIGINS="http://localhost:5173"

# Honor X-Forwarded-For ONLY behind a trusted reverse proxy (default false:
# the header is client-controlled and must not feed rate-limit keys).
TRUST_PROXY="false"

# SQLite default for local dev (no server needed).
DATABASE_URL="sqlite:///./cybershield.db"

# Generous local budgets (requests per window; in-memory per process).
REPORT_RATE_LIMIT="10"
REPORT_RATE_WINDOW_SECONDS="3600"
ANALYZE_RATE_LIMIT="60"
ANALYZE_RATE_WINDOW_SECONDS="3600"
QUIZ_RATE_LIMIT="30"
QUIZ_RATE_WINDOW_SECONDS="3600"
FEEDBACK_RATE_LIMIT="10"
FEEDBACK_RATE_WINDOW_SECONDS="3600"
LOGIN_RATE_LIMIT="5"
LOGIN_RATE_WINDOW_SECONDS="300"

# Max /api request body in bytes (larger → HTTP 413).
MAX_BODY_BYTES="262144"

# Interactive API docs. Default: ON in dev, OFF in production.
# ENABLE_DOCS="true"

# First admin, created on boot ONLY if no admin exists (dev convenience).
# Prefer scripts/create_admin.py on shared/production machines.
# ADMIN_EMAIL="admin@example.com"
# ADMIN_PASSWORD="change-me-immediately"

# Dev-only JWT secret fallback is compiled in and warns loudly.
# Set a real one even in dev if multiple services share the DB.
# JWT_SECRET="dev-local-only-not-for-production"
JWT_EXPIRE_MINUTES="60"

# ---------------------------------------------------------------- (C) testing
# Backend tests use an isolated in-memory SQLite DB automatically
# (tests/conftest.py) — no DATABASE_URL needed. Frontend tests mock the
# API layer (no network). Optional tightening for CI:
# ANALYZE_RATE_LIMIT / QUIZ_RATE_LIMIT may be lowered via env; the suite
# resets all limiters between tests, so defaults are CI-safe.

# ---------------------------------------------------------------- (D) production
# REQUIRED — the backend REFUSES to boot in production without these:
#   ENV=production
#   ALLOWED_ORIGINS=https://<your-frontend-domain>     (never "*" or empty)
#   JWT_SECRET=<strong random string, >=32 chars>       (never the dev default)
#   DATABASE_URL=postgresql+psycopg2://<user>:<pass>@<host>:5432/<db>
# STRONGLY RECOMMENDED:
#   TRUST_PROXY=true                  (only behind your trusted proxy)
#   BACKEND_HOST=127.0.0.1            (uvicorn never exposed directly)
#   tighter *_RATE_LIMIT / *_RATE_WINDOW_SECONDS for expected traffic
#   ADMIN_EMAIL/ADMIN_PASSWORD for first boot, then rotate immediately
#   ENABLE_DOCS unset (docs stay off)
# PLATFORM NOTES:
#   Frontend (Vercel/Netlify or nginx): set its backend URL to the public
#   API origin. Backend (Render/Railway/Fly.io): provide the variables above
#   via the platform's secret store. Database: managed PostgreSQL with
#   automated backups (see docs/database-backup.md). No provider is
#   hard-coded anywhere — everything is environment-driven.
